# Optional: external POST /api/events stays disabled when this is absent.
# Give each trusted producer its own 32+ character secret, fixed kind, and explicit worker/task scopes.
MISSION_CONTROL_INGEST_CREDENTIALS='{"collector:example":{"kind":"COLLECTOR","token":"replace-with-at-least-32-secret-characters","workers":["example"],"tasks":["task:example"]}}'

# Required for the owner dashboard. Keep these distinct from worker and supervisor credentials.
MISSION_CONTROL_OWNER_ID='owner:primary'
MISSION_CONTROL_OWNER_TOKEN='replace-with-at-least-32-random-characters'
MISSION_CONTROL_SESSION_SECRET='replace-with-at-least-32-random-characters'

# Set only when an HTTPS reverse proxy/private overlay exposes the dashboard remotely.
# MISSION_CONTROL_PUBLIC_ORIGIN=https://mission-control.private.example
# MISSION_CONTROL_SECURE_COOKIES=1

# A worker sidecar receives only its own scoped credential.
# MISSION_CONTROL_WORKER_TOKEN='replace-with-that-worker-scoped-token'

# The private MCP stdio bridge receives a read-only SUPERVISOR credential.
# MISSION_CONTROL_MCP_TOKEN='replace-with-supervisor-scoped-token'
# MISSION_CONTROL_MCP_PRODUCER_ID='supervisor:chatgpt-tunnel'
# MISSION_CONTROL_MCP_URL=http://127.0.0.1:3000/api/mcp

# GitHub is the only supervisory decision return path. Configure the exact
# repository, decision issue, capability issue, authorized writer login(s), and
# per-chat capability challenges in one central policy. The example below is
# schematic; use fresh nonces/expiry and exact live chat/model labels.
# MISSION_CONTROL_GITHUB_RECEIPT_POLICY_JSON='{"repository":"owner/repo","decisionIssueNumber":59,"capabilityIssueNumber":60,"authorizedWriterLogins":["owner"],"capabilityChallenges":[]}'
#
# The private supervisor directory binds stable supervisor identities to bootstrap
# ChatGPT locators. Real conversation URLs/IDs can be sensitive: configure exact
# values only in the private runtime environment; never commit them to this public
# repository. The PROJECT_MANAGER entry must use supervisorId mc-project-manager,
# and bootstrapCapability.challengeId must match a live capabilityChallenges entry
# in MISSION_CONTROL_GITHUB_RECEIPT_POLICY_JSON. Every supervisor must have a
# distinct bootstrapCapability.chatId and normalized conversation URL.
# MISSION_CONTROL_SUPERVISOR_CHATS_JSON='[{"scope":"PROJECT_MANAGER","supervisorId":"mc-project-manager","label":"Mission Control Project Manager","workerId":null,"requiredApp":"Mission Control","registrationId":"registration:mc-project-manager:REPLACE_RANDOM_SUFFIX","ownership":"MISSION_CONTROL_ONLY","purpose":"Dedicated Mission Control Project Manager supervision only; never use as a personal or shared-purpose conversation.","accountAlias":"REPLACE_PRIVATE_ACCOUNT_ALIAS","workspaceAlias":"REPLACE_PRIVATE_WORKSPACE_ALIAS","privateLocatorRef":"owner-config:supervisors/mc-project-manager","registrationProvenance":{"registeredBy":"OWNER","registeredAt":"REPLACE_ISO_REGISTRATION_TIME","sourceRef":"REPLACE_OWNER_AUTHORITY_REFERENCE"},"consumerControls":{"modelVisibleLabel":"GPT-5.6 Sol","thinkingControlLabel":"Thinking effort","thinkingVisibleLabel":"Extra High","thinkingOrdinal":"4 of 5","accountPlanLabel":"Pro","accountPlanRole":"PROVENANCE_METADATA_ONLY","accountPlanIsReasoningMode":false},"bootstrapCapability":{"chatId":"REPLACE_UNIQUE_PRIVATE_CHAT_ID","url":"https://chatgpt.com/c/REPLACE_UNIQUE_PRIVATE_CONVERSATION_ID","challengeId":"REPLACE_MATCHING_LIVE_CHALLENGE_ID"}}]'
#
# One Mission Control pacing domain owns the durable provider queue, account-
# wide rate-limit state, single active host lease, and append-only send ledger.
# Both VPS relays call /api/submission-authority with their normal source-bound
# ingest credential. Keep lease and locator values in this private environment.
# MISSION_CONTROL_SUBMISSION_PACING_DOMAIN='chatgpt:REPLACE_PRIVATE_ACCOUNT_DOMAIN'
# MISSION_CONTROL_SUBMISSION_ACTIVE_LEASE_JSON='{"schemaVersion":1,"leaseId":"REPLACE_RANDOM_LEASE_ID","epoch":1,"activeHostAlias":"REPLACE_PRIMARY_ALIAS","activeHostRole":"PRIMARY","issuedAt":"REPLACE_ISO_TIME","expiresAt":"REPLACE_LATER_ISO_TIME","splitBrainStatus":"SINGLE_ACTIVE_CONFIRMED","takeover":null}'
# MISSION_CONTROL_MIN_SUBMISSION_INTERVAL_MS=60000
# MISSION_CONTROL_SUBMISSION_ADMISSION_TTL_MS=120000
#
# Public repositories can use low-frequency reconciliation polling without a
# GitHub token. Set a fine-grained read-only Issues token only when higher rate
# limits/private-repository access are required.
# MISSION_CONTROL_GITHUB_RECONCILIATION_TOKEN='optional-read-only-issues-token'
# MISSION_CONTROL_GITHUB_RECONCILIATION_INTERVAL_MS=300000
#
# The webhook secret is independent of polling and enables the signed fast path.
# MISSION_CONTROL_GITHUB_WEBHOOK_SECRET='replace-with-at-least-32-random-characters'

# Optional runtime overrides.
# MISSION_CONTROL_DB=/absolute/path/mission-control.db
# MISSION_CONTROL_DAEMON_URL=http://127.0.0.1:4100
# MISSION_CONTROL_DAEMON_PORT=4100
# MISSION_CONTROL_SKIP_SEED=1
