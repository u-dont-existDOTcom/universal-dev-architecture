# Optional: external POST /api/events stays disabled when this is absent.
# Give each trusted producer its own 32+ character secret, fixed kind, and explicit worker/task scopes.
MISSION_CONTROL_INGEST_CREDENTIALS='{"collector:example":{"kind":"COLLECTOR","token":"replace-with-at-least-32-secret-characters","workers":["example"],"tasks":["task:example"]}}'

# Required for the owner dashboard. Keep these distinct from worker and supervisor credentials.
MISSION_CONTROL_OWNER_ID='owner:primary'
MISSION_CONTROL_OWNER_TOKEN='replace-with-at-least-32-random-characters'
MISSION_CONTROL_SESSION_SECRET='replace-with-at-least-32-random-characters'

# Set only when an HTTPS reverse proxy/private overlay exposes the dashboard remotely.
# MISSION_CONTROL_PUBLIC_ORIGIN=https://mission-control.private.example
# MISSION_CONTROL_SECURE_COOKIES=1

# A worker sidecar receives only its own scoped credential.
# MISSION_CONTROL_WORKER_TOKEN='replace-with-that-worker-scoped-token'

# The private MCP stdio bridge receives a read-only SUPERVISOR credential.
# MISSION_CONTROL_MCP_TOKEN='replace-with-supervisor-scoped-token'
# MISSION_CONTROL_MCP_PRODUCER_ID='supervisor:chatgpt-tunnel'
# MISSION_CONTROL_MCP_URL=http://127.0.0.1:3000/api/mcp

# GitHub is the only supervisory decision return path. The webhook secret
# authenticates issue_comment delivery; the token enables missed-webhook polling.
# MISSION_CONTROL_GITHUB_WEBHOOK_SECRET='replace-with-at-least-32-random-characters'
# MISSION_CONTROL_GITHUB_RECONCILIATION_TOKEN='replace-with-fine-grained-read-only-issues-token'
# MISSION_CONTROL_GITHUB_RECONCILIATION_INTERVAL_MS=300000

# Optional runtime overrides.
# MISSION_CONTROL_DB=/absolute/path/mission-control.db
# MISSION_CONTROL_DAEMON_URL=http://127.0.0.1:4100
# MISSION_CONTROL_DAEMON_PORT=4100
# MISSION_CONTROL_SKIP_SEED=1
