# Optional: external POST /api/events stays disabled when this is absent.
# Give each trusted producer its own 32+ character secret and fixed kind.
MISSION_CONTROL_INGEST_CREDENTIALS='{"collector:example":{"kind":"COLLECTOR","token":"replace-with-at-least-32-secret-characters"}}'

