# Optional: external POST /api/events stays disabled when this is absent.
# Give each trusted producer its own 32+ character secret, fixed kind, and explicit worker/task scopes.
MISSION_CONTROL_INGEST_CREDENTIALS='{"collector:example":{"kind":"COLLECTOR","token":"replace-with-at-least-32-secret-characters","workers":["example"],"tasks":["task:example"]}}'

# Optional runtime overrides.
# MISSION_CONTROL_DB=/absolute/path/mission-control.db
# MISSION_CONTROL_DAEMON_URL=http://127.0.0.1:4100
# MISSION_CONTROL_DAEMON_PORT=4100
# MISSION_CONTROL_SKIP_SEED=1
