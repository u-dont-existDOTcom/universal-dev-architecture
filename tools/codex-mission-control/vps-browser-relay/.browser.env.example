# Browser-only configuration. This file is deliberately separate from relay and
# scheduler credentials, so the Chromium process cannot inherit their tokens.
MC_RELAY_BROWSER_PROFILE_DIR=/home/USER/.local/share/mission-control-chatgpt-profile
# Chromium's auxiliary configuration, including crash metadata, stays inside
# the same dedicated writable profile rather than the owner's normal config.
# MC_RELAY_BROWSER_CONFIG_DIR=/home/USER/.local/share/mission-control-chatgpt-profile/xdg-config
# Set only when the service's NoNewPrivileges boundary prevents a setuid helper
# and the host permits Chromium's native unprivileged user-namespace sandbox.
# This is not --no-sandbox.
# MC_RELAY_BROWSER_DISABLE_SETUID_SANDBOX=1
MC_RELAY_CDP_HOST=127.0.0.1
MC_RELAY_CDP_PORT=9222
# MC_RELAY_BROWSER_BIN=/usr/bin/chromium
# MC_RELAY_DISPLAY=:99
