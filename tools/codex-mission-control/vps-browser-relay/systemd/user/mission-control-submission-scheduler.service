[Unit]
Description=Mission Control central ChatGPT submission scheduler
After=network-online.target
Wants=network-online.target
Before=mission-control-chatgpt-relay.service

[Service]
Type=simple
Slice=mission-control-chatgpt.slice
EnvironmentFile=%h/.config/mission-control-chatgpt-relay/env
ExecStart=%h/.local/share/mission-control-chatgpt-relay/app/bin/mc-submission-scheduler.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
OOMPolicy=stop
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.config/mission-control-chatgpt-relay
ReadWritePaths=%h/.local/state/mission-control-chatgpt-relay
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

[Install]
WantedBy=default.target
