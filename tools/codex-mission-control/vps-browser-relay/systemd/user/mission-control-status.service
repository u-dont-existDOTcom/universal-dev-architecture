[Unit]
Description=Mission Control read-only journal status

[Service]
Type=simple
EnvironmentFile=%h/.config/mission-control-chatgpt-relay/relay.env
ExecStart=/usr/bin/node %h/mission-control/vps-browser-relay/bin/mc-status.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
