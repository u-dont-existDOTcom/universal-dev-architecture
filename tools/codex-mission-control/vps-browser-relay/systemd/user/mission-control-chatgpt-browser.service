[Unit]
Description=Dedicated VPS ChatGPT browser for Mission Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=mission-control-chatgpt.slice
EnvironmentFile=%h/.config/mission-control-chatgpt-relay/browser-env
Environment=MC_RELAY_BROWSER_FENCE_FILE=/var/lib/mission-control-chatgpt/browser-fences/%u.fenced
ExecStart=%h/.local/share/mission-control-chatgpt-relay/app/scripts/launch-browser.sh
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=20
KillMode=mixed
MemoryHigh=60%
MemoryMax=75%
MemorySwapMax=10%
OOMPolicy=stop
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/mission-control-chatgpt-profile %h/.cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

[Install]
WantedBy=default.target
