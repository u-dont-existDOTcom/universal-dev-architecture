[Unit]
Description=Mission Control relay and browser health report (%i)
After=network-online.target mission-control-chatgpt-browser@%i.service
Wants=network-online.target
Requires=mission-control-chatgpt-browser@%i.service

[Service]
Type=oneshot
User=%i
Slice=mission-control-chatgpt.slice
EnvironmentFile=%h/.config/mission-control-chatgpt-relay/env
ExecStart=%h/.local/share/mission-control-chatgpt-relay/app/bin/mc-chatgpt-relay.mjs health-report
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.config/mission-control-chatgpt-relay
ReadWritePaths=%h/.local/state/mission-control-chatgpt-relay %h/.local/share/mission-control-chatgpt-profile
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
