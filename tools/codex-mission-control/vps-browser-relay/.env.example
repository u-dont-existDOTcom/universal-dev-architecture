# Mission Control endpoint. HTTPS is required outside localhost.
MC_RELAY_MISSION_CONTROL_URL=https://mission-control.example.invalid

# Dedicated relay credential. Configure this producer as COLLECTOR in
# MISSION_CONTROL_INGEST_CREDENTIALS with exact worker scope and task:<worker> scope.
# It may read scoped MCP state and emit evidence receipts; it has no reasoning authority.
MC_RELAY_PRODUCER_ID=collector:chatgpt-relay
MC_RELAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# A second, host-unique secret attests exact automation-owned target-set
# transitions. It must differ from every relay bearer and from the other host's
# attestor. The shared pacing domain must exactly match Mission Control.
MC_RELAY_TARGET_BINDING_ATTESTOR_KEY=REPLACE_WITH_DIFFERENT_AT_LEAST_32_RANDOM_CHARACTERS
MC_RELAY_SUBMISSION_PACING_DOMAIN=chatgpt:REPLACE_PRIVATE_ACCOUNT_DOMAIN

# Both VPS relays use the one durable authority inside Mission Control. The
# authority URL must remain on the configured Mission Control origin; there is
# no installable host-local scheduler or separate scheduler credential.
# MC_RELAY_SUBMISSION_AUTHORITY_URL=https://mission-control.example.invalid/api/submission-authority
MC_RELAY_SUBMISSION_AUTHORITY_TIMEOUT_MS=10000

# Exact deployment identity. These values must match Mission Control's current
# centrally persisted active lease.
MC_RELAY_HOST_ALIAS=REPLACE_PORTABLE_HOST_ALIAS
MC_RELAY_HOST_ROLE=PRIMARY
MC_RELAY_DEPLOYMENT_EPOCH=1
MC_RELAY_DEPLOYMENT_LEASE_ID=REPLACE_RANDOM_LEASE_ID

# Exact chat locators are stored separately with owner-only permissions.
# MC_RELAY_CHATS_FILE=/home/USER/.config/mission-control-chatgpt-relay/chats.json

# The browser service reads browser-env, not this credential-bearing file.
# The relay still uses these loopback connection values.
MC_RELAY_CDP_HOST=127.0.0.1
MC_RELAY_CDP_PORT=9222

# Live task sending and harmless capability testing are separate gates.
# Keep both disabled through login and doctor checks.
MC_RELAY_SUBMIT_ENABLED=0
MC_RELAY_CAPABILITY_TEST_ENABLED=0
MC_RELAY_POLL_INTERVAL_MS=15000
# Global across every registered chat and every send path, including capability
# challenges and fresh mandatory external-tool stages. Accepted range: 60000-600000.
MC_RELAY_MIN_SUBMISSION_INTERVAL_MS=60000
MC_RELAY_RETRY_DELAY_MS=300000
MC_RELAY_MAX_HOT_TABS=3

# Any model turn that remains continuously in generation state for the full
# generation timeout is treated as actively stuck only where same-chat recovery
# is explicitly permitted. Mandatory external-tool stages disable this path and
# recover only in a fresh first-message session. This cap prevents an unbounded
# quota-burning recovery loop elsewhere.
MC_RELAY_STUCK_RECOVERY_MAX_NUDGES=3

# AUTO selects the conservative 8 GB profile below 12 GB total RAM and the
# 16 GB profile at/above 12 GB.
MC_RELAY_MEMORY_PROFILE=AUTO
# Optional explicit overrides; normally leave unset.
# MC_RELAY_MEMORY_SOFT_AVAILABLE_MB=2048
# MC_RELAY_MEMORY_HARD_AVAILABLE_MB=1024
# MC_RELAY_BROWSER_SOFT_RSS_MB=4096
# MC_RELAY_BROWSER_HARD_RSS_MB=5120
# MC_RELAY_SWAP_SOFT_USED_MB=256
# MC_RELAY_SWAP_HARD_USED_MB=768

MC_RELAY_HTTP_TIMEOUT_MS=30000
MC_RELAY_PAGE_READY_TIMEOUT_MS=90000
MC_RELAY_SUBMIT_TIMEOUT_MS=30000
# This is also the active-stall detection interval before a recovery nudge.
MC_RELAY_GENERATION_TIMEOUT_MS=900000
