      "expected": {
        "finding": [
          "META_SUPERVISION_RECURSION"
        ],
        "proposalAccepted": false,
        "requiredDisposition": "REDESIGN_EXISTING_ASSURANCE_PLANE",
        "secondSchedulerCreated": false,
        "secondDashboardCreated": false,
        "secondEventLedgerCreated": false
      }
    },
    {
      "caseId": "ambiguous-owner-statement-fails-to-review",
      "given": {
        "ownerInterventionMeaning": "ambiguous between new requirement and missed pre-existing problem",
        "semanticJudgment": {
          "disposition": "AMBIGUOUS_REVIEW_REQUIRED"
        }
      },
      "expected": {
        "classification": "REVIEW_REQUIRED",
        "assuranceStateMustNotBecomePassByIgnoringRecord": true,
        "codexSemanticInferenceAllowed": false
      }
    }
