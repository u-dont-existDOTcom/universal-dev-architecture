{
  "fixtureId": "owner-discovered-supervision-escape-assurance",
  "directive": "MISSION-CONTROL-SUPERVISION-ESCAPE-ASSURANCE-v1.0.0",
  "purpose": "Prove that Mission Control is externally assured against material failures the owner has to discover first, while excluding genuine new owner input and rejecting recursive meta-supervision.",
  "cases": [
    {
      "caseId": "somatic-owner-forced-progress-review",
      "given": {
        "workerToContract": "GREEN",
        "contractToOwner": "MATCH",
        "outcomeEvidence": [
          "whole-document evidence shows no material owner-outcome advancement",
          "later direct evidence regresses"
        ],
        "systemFindingBeforeOwner": false,
        "systemCorrectionBeforeOwner": false,
        "ownerIntervention": "owner asks whether any progress occurred; only then is focused progress review initiated",
        "semanticJudgment": {
          "disposition": "PREEXISTING_PROBLEM_DISCOVERED",
          "materiality": "CRITICAL",
          "detectableEvidenceAvailableBeforeOwner": true,
          "systemHadAuthorityToSurface": true,
          "familyId": "outcome-regression-not-surfaced"
        }
      },
      "expected": {
        "classification": "SUPERVISION_ESCAPE",
        "finding": [
          "SUPERVISION_ESCAPE_DETECTED",
          "OWNER_DISCOVERED_BEFORE_SYSTEM"
        ],
        "assuranceState": "FAIL",
        "ownerAction": "NONE"
      }
    },
    {
      "caseId": "system-catches-regression-first",
      "given": {
        "sameUnderlyingRegression": true,
        "systemFindingBeforeOwner": true,
        "systemActionBeforeOwner": "current outcome-regression finding plus hold/reasoning review or strategy replacement",
        "ownerLaterRequestsStatus": true,
        "semanticJudgment": {
          "disposition": "OWNER_CONFIRMATION_OF_EXISTING_FINDING",
          "familyId": "outcome-regression-not-surfaced"
        }
      },
      "expected": {
        "classification": "PREVENTED_ESCAPE",
        "finding": [
          "SUPERVISION_ESCAPE_PREVENTED"
        ],
        "materialEscapeCountDelta": 0,
        "preventedEscapeCountDelta": 1
      }
    },
    {
      "caseId": "genuine-new-owner-requirement",
      "given": {
        "systemWasCorrectUnderPriorAuthority": true,
        "ownerIntervention": "owner adds a product requirement not previously present",
        "semanticJudgment": {
          "disposition": "NEW_REQUIREMENT",
          "materiality": "MATERIAL"
        }
      },
      "expected": {
        "classification": "NOT_AN_ESCAPE",
        "materialEscapeCountDelta": 0
      }
    },
    {
      "caseId": "codex-reasoning-controller-owner-correction",
      "given": {
        "observableRoleBreachBeforeOwner": true,
        "roleBreach": "Codex selects strategy, performs substantive reasoning, and judges its own progress",
        "systemFindingBeforeOwner": false,
        "ownerIntervention": "owner corrects architecture: chats reason; Codex executes",
        "semanticJudgment": {
          "disposition": "PREEXISTING_PROBLEM_DISCOVERED",
          "materiality": "CRITICAL",
          "detectableEvidenceAvailableBeforeOwner": true,
          "systemHadAuthorityToSurface": true,
          "familyId": "reasoning-execution-authority-collapse"
        }
      },
      "expected": {
        "classification": "SUPERVISION_ESCAPE",
        "assuranceState": "FAIL",
        "finding": [
          "SUPERVISION_ESCAPE_DETECTED",
          "OWNER_DISCOVERED_BEFORE_SYSTEM"
        ]
      }
    },
    {
      "caseId": "owner-forced-continuation-after-scoped-stop-leakage",
      "given": {
        "projectLocalStop": "NO_FURTHER_EXECUTION_AUTHORIZED",
        "acceptedUniversalContinuationExists": true,
        "rootOwnerDecisionRequired": false,
        "rootTerminalState": false,
        "controllerStopsRootChain": true,
        "ownerIntervention": "owner asks why execution stopped and forces continuation",
        "semanticJudgment": {
          "disposition": "PREEXISTING_PROBLEM_DISCOVERED",
          "materiality": "CRITICAL",
          "detectableEvidenceAvailableBeforeOwner": true,
          "systemHadAuthorityToSurface": true,
          "familyId": "scoped-stop-projected-to-root-chain"
        }
      },
      "expected": {
        "classification": "SUPERVISION_ESCAPE",
        "assuranceState": "FAIL",
        "finding": [
          "SUPERVISION_ESCAPE_DETECTED",
          "OWNER_DISCOVERED_BEFORE_SYSTEM"
        ]
      }
    },
    {
      "caseId": "repeat-family-after-verified-repair",
      "given": {
        "priorEscape": {
          "familyId": "reasoning-execution-authority-collapse",
          "classification": "SUPERVISION_ESCAPE"
        },
        "priorRepairState": "VERIFIED",
        "newEscape": {
          "familyId": "reasoning-execution-authority-collapse",
          "classification": "SUPERVISION_ESCAPE"
        }
      },
      "expected": {
        "finding": [
          "REPEAT_SUPERVISION_ESCAPE",
          "SUPERVISION_REPAIR_FAILED"
