# Codex 0.153.4 Starlark. Rules are argv-prefix checks, not an effect firewall.
# Build/test/package scripts stay IN the workspace sandbox. An allow rule
# permits host execution, so never globally allow a shell/interpreter/manager.

# These read-only GitHub families can use the host's credential helper.
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "pr", ["view", "list", "diff", "checks", "status"]], decision="allow", match=["gh pr view 1", "gh pr checks 1"], not_match=["gh pr merge 1"])
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "issue", ["view", "list", "status"]], decision="allow")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "run", ["view", "list", "watch"]], decision="allow")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "workflow", ["view", "list"]], decision="allow")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "repo", ["view", "list"]], decision="allow")

# Prompt routes to the automatic reviewer when auto_review is active. It does
# not grant permission, and the built-in risk policy remains intact.
prefix_rule(pattern=[["git", "/usr/bin/git", "/bin/git"], ["commit", "fetch", "push", "reset", "clean", "rebase", "branch", "tag", "remote", "config", "worktree", "update-ref", "filter-branch", "filter-repo", "credential", "reflog", "gc", "prune"]], decision="prompt", justification="Review Git effects; ordinary fetch/commit are routine, while deletion, published-history changes, and external writes require their actual authority.", match=["git commit -m fix", "git push origin main --force", "git reset --hard", "git clean -fdx", "git branch -D feature"])
# Global options can move execution to another repository or override config.
prefix_rule(pattern=[["git", "/usr/bin/git", "/bin/git"], ["-C", "-c", "--git-dir", "--work-tree", "--bare", "--config-env"]], decision="prompt")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "api"], decision="prompt", justification="Check HTTP method, endpoint, body, and destination; this command also performs authenticated writes.")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], ["pr", "issue"], ["create", "edit", "close", "reopen", "delete", "merge", "review", "comment", "lock", "unlock", "transfer"]], decision="prompt")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "repo", ["create", "delete", "edit", "rename", "archive", "fork", "sync"]], decision="prompt")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "auth", ["status", "token", "login", "logout", "refresh", "setup-git"]], decision="prompt")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "run", ["cancel", "delete", "rerun"]], decision="prompt")
prefix_rule(pattern=[["gh", "/usr/bin/gh", "/bin/gh"], "workflow", ["run", "enable", "disable"]], decision="prompt")
prefix_rule(pattern=[["rm", "/usr/bin/rm", "/bin/rm", "rmdir", "/usr/bin/rmdir", "/bin/rmdir", "unlink", "/usr/bin/unlink", "/bin/unlink", "shred", "/usr/bin/shred", "/bin/shred", "wipe", "/usr/bin/wipe", "/bin/wipe", "srm", "/usr/bin/srm", "/bin/srm", "dd", "/usr/bin/dd", "/bin/dd", "mkfs", "/usr/bin/mkfs", "/bin/mkfs", "fdisk", "/usr/bin/fdisk", "/bin/fdisk", "parted", "/usr/bin/parted", "/bin/parted"]], decision="prompt", justification="Inspect exact targets and reversibility before deletion or raw-device changes.")
prefix_rule(pattern=[["sudo", "/usr/bin/sudo", "/bin/sudo", "doas", "/usr/bin/doas", "/bin/doas", "pkexec", "/usr/bin/pkexec", "/bin/pkexec", "su", "/usr/bin/su", "/bin/su", "mount", "/usr/bin/mount", "/bin/mount", "umount", "/usr/bin/umount", "/bin/umount", "chown", "/usr/bin/chown", "/bin/chown", "chmod", "/usr/bin/chmod", "/bin/chmod", "systemctl", "/usr/bin/systemctl", "/bin/systemctl", "sysctl", "/usr/bin/sysctl", "/bin/sysctl", "tailscale", "/usr/bin/tailscale", "/bin/tailscale"]], decision="prompt", justification="Privilege, system, access-control, and network configuration changes require review of scope and authority.")
prefix_rule(pattern=[["apt", "/usr/bin/apt", "/bin/apt", "apt-get", "/usr/bin/apt-get", "/bin/apt-get", "dnf", "/usr/bin/dnf", "/bin/dnf", "yum", "/usr/bin/yum", "/bin/yum", "pacman", "/usr/bin/pacman", "/bin/pacman", "snap", "/usr/bin/snap", "/bin/snap", "flatpak", "/usr/bin/flatpak", "/bin/flatpak"]], decision="prompt")
prefix_rule(pattern=[["npm", "/usr/bin/npm", "/bin/npm", "pnpm", "/usr/bin/pnpm", "/bin/pnpm", "yarn", "/usr/bin/yarn", "/bin/yarn"], ["publish", "unpublish", "config", "owner", "token", "login", "logout"]], decision="prompt")
prefix_rule(pattern=[["npm", "/usr/bin/npm", "/bin/npm"], ["-g", "--global"]], decision="prompt")
