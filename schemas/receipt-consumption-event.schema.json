{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u-dont-exist.com/schemas/mission-control/receipt-consumption-event.schema.json",
  "title": "Append-only reasoning receipt consumption event",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "admissionNonce", "transactionId", "verdictId", "responseDigest", "admissionQuestionDigest", "requiredAccountRef"],
  "properties": {
    "receiptId": {"type": "string", "minLength": 1},
    "admissionNonce": {"type": "string", "minLength": 1},
    "transactionId": {"type": "string", "minLength": 1},
    "verdictId": {"type": "string", "minLength": 1},
    "responseDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admissionQuestionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requiredAccountRef": {"type": "string", "minLength": 1, "not": {"enum": ["ANONYMOUS_OR_UNKNOWN", "anonymous", "unknown"]}}
  }
}
