{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u-dont-exist.com/schemas/mission-control/authority-source-registry.schema.json",
  "title": "Immutable relying-party authority source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "registryId", "registryDigest", "sources"],
  "properties": {
    "$schema": {"const": "../schemas/authority-source-registry.schema.json"},
    "schemaVersion": {"const": 1},
    "registryId": {"type": "string", "minLength": 1},
    "registryDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authoritySourceRef", "authorityClass", "authorityScope", "scopeRefs", "status", "sourceRecordDigest"],
        "properties": {
          "authoritySourceRef": {"type": "string", "minLength": 1},
          "authorityClass": {"enum": ["OWNER_EXPLICIT", "OWNER_CORRECTION", "REASONING_DECISION", "ARTIFACT_DERIVED_FACT", "OBSERVED_PLATFORM_STATE", "EXECUTOR_PROPOSAL"]},
          "authorityScope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ASSERT_FACT", "PROMOTE_TO_POLICY", "AUTHOR_SUPERVISORY_VERDICT", "AUTHORIZE_EXECUTION", "AUTHORIZE_RELEASE"]}},
          "scopeRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["CURRENT", "REVOKED", "SUPERSEDED", "STALE"]},
          "sourceRecordDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
